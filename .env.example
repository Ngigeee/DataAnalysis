# Flask configuration
FLASK_SECRET_KEY=replace_with_a_secure_random_secret
FLASK_DEBUG=false

# Database configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=replace_with_your_database_name
DB_USER=replace_with_your_database_user
DB_PASSWORD=replace_with_your_database_password

# Google OAuth
GOOGLE_CLIENT_ID=replace_with_your_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_your_google_client_secret

# Email configuration
MAIL_SERVER=replace_with_your_smtp_server
MAIL_PORT=465
MAIL_USERNAME=replace_with_your_email_address
MAIL_PASSWORD=replace_with_your_email_password

# Player rating configuration
PLAYER_RATING_MODEL=models/player_rating_model.pkl
PLAYER_RATING_BASE_URL=http://localhost:5000
PLAYER_RATING_PAGE=/player-rating
